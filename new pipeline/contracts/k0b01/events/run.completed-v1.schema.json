{
  "$id": "pipeline-v2.alpha0.event.run.completed.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "type": "string"
        },
        "caused_by_event_id": {
          "type": "string"
        },
        "correlation_id": {
          "minLength": 1,
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "type": "string"
        },
        "event_type": {
          "const": "run.completed",
          "type": "string"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "readback_gate_id": {
              "minLength": 1,
              "type": "string"
            },
            "run_id": {
              "minLength": 1,
              "type": "string"
            },
            "sink_acceptance_id": {
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "const": "completed",
              "type": "string"
            }
          },
          "required": [
            "run_id",
            "state",
            "sink_acceptance_id",
            "readback_gate_id"
          ],
          "type": "object"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "const": "1",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "version",
        "run_id",
        "caused_by_event_id",
        "correlation_id",
        "artifact_version_id",
        "payload"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "type": "string"
        },
        "caused_by_event_id": {
          "type": "string"
        },
        "checkpoint_phase_id": {
          "enum": [
            "K0b-runtime-operational",
            "K0b-F15-exact-measurement"
          ],
          "type": "string"
        },
        "correlation_id": {
          "minLength": 1,
          "type": "string"
        },
        "created_at": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "type": "string"
        },
        "event_type": {
          "const": "run.completed",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "partition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "payload": {
          "additionalProperties": false,
          "properties": {
            "completion_gate_id": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "run_id": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "state": {
              "enum": [
                "created",
                "running",
                "waiting",
                "completing",
                "reconciliation_required",
                "reconciling",
                "aborting",
                "completed",
                "aborted",
                "blocked",
                "blocked_over_limit"
              ],
              "type": "string"
            },
            "terminal_revision": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "run_id",
            "state",
            "completion_gate_id",
            "terminal_revision"
          ],
          "type": "object"
        },
        "producer_id": {
          "const": "shared_control.run_fsm",
          "type": "string"
        },
        "profile": {
          "const": "Alpha0",
          "type": "string"
        },
        "project_chain_id": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_id": {
          "const": "pipeline-v2.alpha0.event.run.completed.v1",
          "type": "string"
        },
        "schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "1",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "caused_by_event_id",
        "correlation_id",
        "event_id",
        "event_type",
        "payload",
        "run_id",
        "version",
        "profile",
        "project_chain_id",
        "checkpoint_phase_id",
        "partition_sha256",
        "producer_id",
        "idempotency_key",
        "schema_id",
        "schema_sha256",
        "created_at"
      ],
      "type": "object"
    }
  ]
}
