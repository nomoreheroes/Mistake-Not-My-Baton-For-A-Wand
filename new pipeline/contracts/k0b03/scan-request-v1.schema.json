{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-v2://contracts/k0b03/scan-request-v1",
  "type": "object",
  "required": ["schema_version", "authenticated", "profile_sha256", "caller_byte_cap", "fields"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authenticated": {"const": true},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caller_byte_cap": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field_type", "source_id", "safe_source_binding", "text_utf8"],
        "properties": {
          "field_type": {"const": "untrusted_text"},
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"},
          "safe_source_binding": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
          "text_utf8": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
