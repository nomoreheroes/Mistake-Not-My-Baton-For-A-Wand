{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-v2.k0b02.projection-pair-receipt-v1.schema",
  "type": "object",
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_version_id": {
      "type": "string",
      "minLength": 1
    },
    "source_seq": {
      "type": "integer",
      "minimum": 1
    },
    "outbox_id": {
      "type": "string",
      "minLength": 1
    },
    "outbox_high_water": {
      "type": "integer",
      "minimum": 0
    },
    "pair_stem": {
      "type": "string",
      "enum": [
        "fixture-decision"
      ]
    },
    "projection_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "yaml_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "markdown_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ready": {
      "type": "boolean"
    },
    "result": {
      "type": "string",
      "enum": [
        "written",
        "failed"
      ]
    }
  },
  "required": [
    "projection_id",
    "decision_version_id",
    "source_seq",
    "outbox_id",
    "outbox_high_water",
    "pair_stem",
    "projection_profile_sha256",
    "yaml_sha256",
    "markdown_sha256",
    "ready",
    "result"
  ],
  "additionalProperties": false
}
